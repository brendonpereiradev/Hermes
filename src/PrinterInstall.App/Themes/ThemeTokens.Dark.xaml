<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Tema escuro: superfícies e acento do Talos.
    Todos os neutros ficam no mesmo matiz azul-ardósia, em três profundidades:
    campo (mais fundo) < janela < painel. Nenhum cinza neutro do WPF UI deve aparecer.
  -->

  <!-- Janela -->
  <Color x:Key="AppCanvasBackgroundColor">#FF101318</Color>
  <SolidColorBrush x:Key="AppCanvasBackgroundBrush" Color="{StaticResource AppCanvasBackgroundColor}"/>

  <!-- Painéis -->
  <Color x:Key="AppSurfaceColor">#FF181C23</Color>
  <SolidColorBrush x:Key="AppSurfaceCardBrush" Color="{StaticResource AppSurfaceColor}"/>
  <SolidColorBrush x:Key="AppSurfaceCardBorderBrush" Color="#FF262C36"/>
  <SolidColorBrush x:Key="AppSurfaceHoverBrush" Color="#FF1F242D"/>
  <SolidColorBrush x:Key="AppLineStrongBrush" Color="#FF333B47"/>

  <!-- Campos de entrada: afundados em relação ao painel -->
  <Color x:Key="AppInputColor">#FF0E1116</Color>
  <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="{StaticResource AppInputColor}"/>
  <SolidColorBrush x:Key="AppInputBorderBrush" Color="#FF2C333E"/>
  <SolidColorBrush x:Key="AppInputHoverBorderBrush" Color="#FF3A4350"/>

  <!-- Log -->
  <SolidColorBrush x:Key="AppConsoleBackgroundBrush" Color="{StaticResource AppInputColor}"/>
  <SolidColorBrush x:Key="AppConsoleBorderBrush" Color="#FF262C36"/>
  <SolidColorBrush x:Key="AppConsoleForegroundBrush" Color="#FFC9D0DA"/>

  <!-- Texto -->
  <Color x:Key="AppTextPrimaryColor">#FFE6E9EE</Color>
  <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#FF98A2B0"/>
  <SolidColorBrush x:Key="AppTextMutedBrush" Color="#FF7A8494"/>

  <!-- Acento -->
  <Color x:Key="AppAccentColor">#FF4C8DF6</Color>
  <SolidColorBrush x:Key="AppBrandAccentBrush" Color="{StaticResource AppAccentColor}"/>
  <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#FF639CF7"/>
  <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#FF3F7EE6"/>
  <SolidColorBrush x:Key="AppAccentForegroundBrush" Color="#FF0B1220"/>
  <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FF8DB5FA"/>
  <SolidColorBrush x:Key="AppBrandSubtitleBrush" Color="#FF8DB5FA"/>

  <!-- Tabelas -->
  <SolidColorBrush x:Key="AppTableHoverBrush" Color="#FF1C2129"/>
  <SolidColorBrush x:Key="AppTableRowSelectedBrush" Color="#FF20262F"/>
  <SolidColorBrush x:Key="AppTableDividerBrush" Color="#FF20252D"/>

  <!-- Badges semânticos: mesmo matiz de fundo, cor só no texto e na borda -->
  <SolidColorBrush x:Key="AppBadgeSuccessBackgroundBrush" Color="#FF132620"/>
  <SolidColorBrush x:Key="AppBadgeSuccessBorderBrush" Color="#FF225C44"/>
  <SolidColorBrush x:Key="AppBadgeSuccessForegroundBrush" Color="#FF3DD68C"/>

  <SolidColorBrush x:Key="AppBadgeDangerBackgroundBrush" Color="#FF2A181C"/>
  <SolidColorBrush x:Key="AppBadgeDangerBorderBrush" Color="#FF7A3337"/>
  <SolidColorBrush x:Key="AppBadgeDangerForegroundBrush" Color="#FFF0605D"/>

  <SolidColorBrush x:Key="AppBadgeInfoBackgroundBrush" Color="#FF15213A"/>
  <SolidColorBrush x:Key="AppBadgeInfoBorderBrush" Color="#FF2E4A73"/>
  <SolidColorBrush x:Key="AppBadgeInfoForegroundBrush" Color="#FF8DB5FA"/>

  <SolidColorBrush x:Key="AppBadgeWarningBackgroundBrush" Color="#FF282418"/>
  <SolidColorBrush x:Key="AppBadgeWarningBorderBrush" Color="#FF6E5A26"/>
  <SolidColorBrush x:Key="AppBadgeWarningForegroundBrush" Color="#FFF2C14E"/>

  <SolidColorBrush x:Key="AppBadgeNeutralBackgroundBrush" Color="#FF181C23"/>
  <SolidColorBrush x:Key="AppBadgeNeutralBorderBrush" Color="#FF333B47"/>
  <SolidColorBrush x:Key="AppBadgeNeutralForegroundBrush" Color="#FF98A2B0"/>

  <!--
    Controles do WPF UI na mesma paleta. Os valores padrão dele são cinza neutro (#202020)
    e brancos translúcidos, que clareiam os campos sobre os painéis e destoam do azul-ardósia.
  -->

  <!-- Fundo da janela (o WPF UI lê a cor, não o pincel, ao aplicar o fundo) -->
  <Color x:Key="ApplicationBackgroundColor">#FF101318</Color>
  <Color x:Key="SolidBackgroundFillColorBase">#FF101318</Color>
  <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource AppCanvasBackgroundColor}"/>
  <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource AppCanvasBackgroundColor}"/>
  <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource AppCanvasBackgroundColor}"/>

  <!-- Texto -->
  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF98A2B0"/>
  <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF7A8494"/>
  <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="CardForeground" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="ExpanderHeaderForeground" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="CheckBoxForeground" Color="{StaticResource AppTextPrimaryColor}"/>

  <!-- Botões genéricos e cartões -->
  <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource AppSurfaceColor}"/>
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF1F242D"/>
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF15191F"/>
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource AppSurfaceColor}"/>
  <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF1F242D"/>
  <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF15191F"/>
  <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource AppInputColor}"/>
  <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF262C36"/>
  <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#FF333B47"/>
  <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource AppSurfaceColor}"/>
  <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF1F242D"/>
  <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{StaticResource AppSurfaceColor}"/>
  <SolidColorBrush x:Key="ExpanderContentBackground" Color="{StaticResource AppSurfaceColor}"/>
  <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#FF262C36"/>
  <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="#FF333B47"/>

  <!-- Caixas de texto -->
  <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource AppInputColor}"/>
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF12161C"/>
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource AppInputColor}"/>
  <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF6B7584"/>
  <SolidColorBrush x:Key="TextControlButtonForeground" Color="#FF98A2B0"/>
  <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#FF2C333E"/>
  <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{StaticResource AppAccentColor}"/>

  <!-- Listas suspensas -->
  <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource AppInputColor}"/>
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FF12161C"/>
  <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource AppInputColor}"/>
  <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF1C2129"/>
  <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#FF333B47"/>
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#FF98A2B0"/>
  <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#FF262C36"/>

  <!-- Caixas de seleção -->
  <SolidColorBrush x:Key="CheckBoxBackground" Color="{StaticResource AppInputColor}"/>
  <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#FF4A5361"/>
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#FF12161C"/>
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#FF0B1220"/>
</ResourceDictionary>
