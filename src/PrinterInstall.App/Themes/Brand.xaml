<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Marca do Hermes. O emblema não muda com o tema: o ladrilho grafite é o mesmo do Talos e do Hefesto.
    scripts/New-HermesIcons.ps1 lê este arquivo para gerar Assets/app.ico e Assets/app.png.
  -->

  <Color x:Key="HermesTileTopColor">#FF1F2530</Color>
  <Color x:Key="HermesTileBottomColor">#FF101318</Color>
  <Color x:Key="HermesSheetColor">#FFE6E9EE</Color>
  <Color x:Key="HermesSheetFoldColor">#FF98A2B0</Color>
  <Color x:Key="HermesWingColor">#FFE8A05C</Color>
  <Color x:Key="HermesCyanColor">#FF38BDF8</Color>
  <Color x:Key="HermesMagentaColor">#FFDB2777</Color>
  <Color x:Key="HermesYellowColor">#FFEAB308</Color>
  <Color x:Key="HermesFrameColor">#664C8DF6</Color>

  <LinearGradientBrush x:Key="HermesTileBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="{StaticResource HermesTileTopColor}"/>
    <GradientStop Offset="1" Color="{StaticResource HermesTileBottomColor}"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="HermesSheetBrush" Color="{StaticResource HermesSheetColor}"/>
  <SolidColorBrush x:Key="HermesSheetFoldBrush" Color="{StaticResource HermesSheetFoldColor}"/>
  <SolidColorBrush x:Key="HermesWingBrush" Color="{StaticResource HermesWingColor}"/>
  <SolidColorBrush x:Key="HermesCyanBrush" Color="{StaticResource HermesCyanColor}"/>
  <SolidColorBrush x:Key="HermesMagentaBrush" Color="{StaticResource HermesMagentaColor}"/>
  <SolidColorBrush x:Key="HermesYellowBrush" Color="{StaticResource HermesYellowColor}"/>
  <SolidColorBrush x:Key="HermesFrameBrush" Color="{StaticResource HermesFrameColor}"/>

  <!-- Emblema completo (48 px ou mais): três penas, folha com dobra e linhas CMY. -->
  <DrawingImage x:Key="HermesEmblemImage">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{StaticResource HermesTileBrush}">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,128,128" RadiusX="28" RadiusY="28"/>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource HermesFrameBrush}" Thickness="3"/>
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="1.5,1.5,125,125" RadiusX="26.5" RadiusY="26.5"/>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource HermesSheetBrush}" Geometry="M56,28 H86 L98,40 V100 H56 Z"/>
        <GeometryDrawing Brush="{StaticResource HermesSheetFoldBrush}" Geometry="M86,28 V40 H98 Z"/>
        <GeometryDrawing Geometry="M65,54 H89">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource HermesCyanBrush}" Thickness="5" StartLineCap="Round" EndLineCap="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M65,66 H89">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource HermesMagentaBrush}" Thickness="5" StartLineCap="Round" EndLineCap="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M65,78 H81">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource HermesYellowBrush}" Thickness="5" StartLineCap="Round" EndLineCap="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M56,50 C44,48 30,40 20,28 M56,62 C44,61 32,56 22,48 M56,74 C46,74 38,71 30,66">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource HermesWingBrush}" Thickness="6" StartLineCap="Round" EndLineCap="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Emblema de 24 a 32 px: duas penas e linhas mais grossas, para não virar borrão. -->
  <DrawingImage x:Key="HermesEmblemSmallImage">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{StaticResource HermesTileBrush}">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,128,128" RadiusX="28" RadiusY="28"/>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource HermesSheetBrush}" Geometry="M56,28 H86 L98,40 V100 H56 Z"/>
        <GeometryDrawing Geometry="M65,54 H89">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource HermesCyanBrush}" Thickness="8" StartLineCap="Round" EndLineCap="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M65,68 H89">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource HermesMagentaBrush}" Thickness="8" StartLineCap="Round" EndLineCap="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M65,82 H81">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource HermesYellowBrush}" Thickness="8" StartLineCap="Round" EndLineCap="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M56,50 C44,48 30,40 20,28 M56,68 C44,67 34,62 24,54">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource HermesWingBrush}" Thickness="9" StartLineCap="Round" EndLineCap="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Emblema de 16 px: folha lisa com uma linha e duas penas. -->
  <DrawingImage x:Key="HermesEmblemTinyImage">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{StaticResource HermesTileBrush}">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,128,128" RadiusX="24" RadiusY="24"/>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource HermesSheetBrush}" Geometry="M56,24 H98 V104 H56 Z"/>
        <GeometryDrawing Geometry="M66,52 H88">
          <GeometryDrawing.Pen>
            <Pen Brush="#FF4C8DF6" Thickness="12" StartLineCap="Round" EndLineCap="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M56,46 C42,44 30,36 18,22 M56,70 C42,69 32,64 22,56">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource HermesWingBrush}" Thickness="14" StartLineCap="Round" EndLineCap="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>
