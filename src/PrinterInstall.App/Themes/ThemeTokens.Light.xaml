<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Tema claro: superfícies do Hefesto com o acento do Hermes.
    Mesmo matiz azul-ardósia do tema escuro, invertido: janela < campo < painel em claridade.
  -->

  <!-- Janela -->
  <Color x:Key="AppCanvasBackgroundColor">#FFF1F4F8</Color>
  <SolidColorBrush x:Key="AppCanvasBackgroundBrush" Color="{StaticResource AppCanvasBackgroundColor}"/>

  <!-- Painéis -->
  <Color x:Key="AppSurfaceColor">#FFFFFFFF</Color>
  <SolidColorBrush x:Key="AppSurfaceCardBrush" Color="{StaticResource AppSurfaceColor}"/>
  <SolidColorBrush x:Key="AppSurfaceCardBorderBrush" Color="#FFDDE3EB"/>
  <SolidColorBrush x:Key="AppSurfaceHoverBrush" Color="#FFEDF1F6"/>
  <SolidColorBrush x:Key="AppLineStrongBrush" Color="#FFC9D2DE"/>

  <!-- Campos de entrada: levemente afundados em relação ao painel branco -->
  <Color x:Key="AppInputColor">#FFF7F9FC</Color>
  <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="{StaticResource AppInputColor}"/>
  <SolidColorBrush x:Key="AppInputBorderBrush" Color="#FFD3DAE4"/>
  <SolidColorBrush x:Key="AppInputHoverBorderBrush" Color="#FFB9C4D2"/>

  <!-- Log -->
  <SolidColorBrush x:Key="AppConsoleBackgroundBrush" Color="{StaticResource AppInputColor}"/>
  <SolidColorBrush x:Key="AppConsoleBorderBrush" Color="#FFDDE3EB"/>
  <SolidColorBrush x:Key="AppConsoleForegroundBrush" Color="#FF253247"/>

  <!-- Texto -->
  <Color x:Key="AppTextPrimaryColor">#FF111A2C</Color>
  <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#FF465569"/>
  <SolidColorBrush x:Key="AppTextMutedBrush" Color="#FF5F6E82"/>

  <!-- Acento -->
  <Color x:Key="AppAccentColor">#FF2F6FE0</Color>
  <SolidColorBrush x:Key="AppBrandAccentBrush" Color="{StaticResource AppAccentColor}"/>
  <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#FF2661CC"/>
  <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#FF2155B3"/>
  <SolidColorBrush x:Key="AppAccentForegroundBrush" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FF2155B3"/>
  <SolidColorBrush x:Key="AppBrandSubtitleBrush" Color="#FF2661CC"/>

  <!-- Tabelas -->
  <SolidColorBrush x:Key="AppTableHoverBrush" Color="#FFF7F9FC"/>
  <SolidColorBrush x:Key="AppTableRowSelectedBrush" Color="#FFEDF1F6"/>
  <SolidColorBrush x:Key="AppTableDividerBrush" Color="#FFE7ECF2"/>

  <!-- Badges semânticos -->
  <SolidColorBrush x:Key="AppBadgeSuccessBackgroundBrush" Color="#FFEAF6EF"/>
  <SolidColorBrush x:Key="AppBadgeSuccessBorderBrush" Color="#FFA6D4B6"/>
  <SolidColorBrush x:Key="AppBadgeSuccessForegroundBrush" Color="#FF1F8A50"/>

  <SolidColorBrush x:Key="AppBadgeDangerBackgroundBrush" Color="#FFFCEEEE"/>
  <SolidColorBrush x:Key="AppBadgeDangerBorderBrush" Color="#FFEBB2B2"/>
  <SolidColorBrush x:Key="AppBadgeDangerForegroundBrush" Color="#FFC23636"/>

  <SolidColorBrush x:Key="AppBadgeInfoBackgroundBrush" Color="#FFEBF2FD"/>
  <SolidColorBrush x:Key="AppBadgeInfoBorderBrush" Color="#FFA9C3F2"/>
  <SolidColorBrush x:Key="AppBadgeInfoForegroundBrush" Color="#FF2155B3"/>

  <SolidColorBrush x:Key="AppBadgeWarningBackgroundBrush" Color="#FFFCF5E8"/>
  <SolidColorBrush x:Key="AppBadgeWarningBorderBrush" Color="#FFE3C584"/>
  <SolidColorBrush x:Key="AppBadgeWarningForegroundBrush" Color="#FF8F5410"/>

  <SolidColorBrush x:Key="AppBadgeNeutralBackgroundBrush" Color="#FFF1F4F8"/>
  <SolidColorBrush x:Key="AppBadgeNeutralBorderBrush" Color="#FFC9D2DE"/>
  <SolidColorBrush x:Key="AppBadgeNeutralForegroundBrush" Color="#FF465569"/>

  <!--
    Controles do WPF UI na mesma paleta. Os valores padrão dele são cinza neutro (#FAFAFA)
    e brancos translúcidos, que destoam do azul-ardósia.
  -->

  <!-- Fundo da janela (o WPF UI lê a cor, não o pincel, ao aplicar o fundo) -->
  <Color x:Key="ApplicationBackgroundColor">#FFF1F4F8</Color>
  <Color x:Key="SolidBackgroundFillColorBase">#FFF1F4F8</Color>
  <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource AppCanvasBackgroundColor}"/>
  <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource AppCanvasBackgroundColor}"/>
  <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource AppCanvasBackgroundColor}"/>

  <!-- Texto -->
  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF465569"/>
  <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF5F6E82"/>
  <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="CardForeground" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="ExpanderHeaderForeground" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="CheckBoxForeground" Color="{StaticResource AppTextPrimaryColor}"/>

  <!-- Botões genéricos e cartões -->
  <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource AppSurfaceColor}"/>
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFEDF1F6"/>
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFE4E9F0"/>
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource AppSurfaceColor}"/>
  <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFEDF1F6"/>
  <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FFE4E9F0"/>
  <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FFDDE3EB"/>
  <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#FFC9D2DE"/>
  <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource AppSurfaceColor}"/>
  <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FFF7F9FC"/>
  <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{StaticResource AppSurfaceColor}"/>
  <SolidColorBrush x:Key="ExpanderContentBackground" Color="{StaticResource AppSurfaceColor}"/>
  <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#FFDDE3EB"/>
  <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="#FFC9D2DE"/>

  <!-- Caixas de texto -->
  <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource AppInputColor}"/>
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFF2F5F9"/>
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF7A8798"/>
  <SolidColorBrush x:Key="TextControlButtonForeground" Color="#FF465569"/>
  <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#FFD3DAE4"/>
  <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{StaticResource AppAccentColor}"/>

  <!-- Listas suspensas -->
  <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource AppInputColor}"/>
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFF2F5F9"/>
  <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#FFC9D2DE"/>
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#FF465569"/>
  <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource AppTextPrimaryColor}"/>
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#FFEDF1F6"/>

  <!-- Caixas de seleção -->
  <SolidColorBrush x:Key="CheckBoxBackground" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#FF9AA7B8"/>
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#FFF2F5F9"/>
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#FFFFFFFF"/>
</ResourceDictionary>
