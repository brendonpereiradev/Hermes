<appControls:HermesWindow x:Class="PrinterInstall.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:PrinterInstall.App.Converters"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        xmlns:appControls="clr-namespace:PrinterInstall.App.Controls"
        Title="{DynamicResource Login_WindowTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="400" MinHeight="480"
        SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{DynamicResource AppCanvasBackgroundBrush}"
        TextElement.Foreground="{DynamicResource AppTextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <appControls:HermesWindow.Resources>
        <conv:StringNullOrWhiteSpaceToVisibilityConverter x:Key="StringNullOrEmptyToVis"/>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter"/>

        <Style x:Key="LoginFieldContainerStyle" TargetType="Border">
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppInputBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AppBrandAccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginInnerTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppBrandAccentBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LoginInnerPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppBrandAccentBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Durante a autenticação o botão vira "Cancelar", com contorno no lugar do acento cheio. -->
        <Style x:Key="LoginSubmitButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAuthenticating}" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AppLineStrongBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                    <Setter Property="MouseOverBackground" Value="{DynamicResource AppSurfaceHoverBrush}"/>
                    <Setter Property="MouseOverBorderBrush" Value="{DynamicResource AppBrandAccentBrush}"/>
                    <Setter Property="PressedBackground" Value="{DynamicResource AppSurfaceHoverBrush}"/>
                    <Setter Property="PressedForeground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                    <Setter Property="ToolTip" Value="{DynamicResource Login_CancelSignInToolTip}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </appControls:HermesWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- A marca fica no conteúdo, em tamanho grande; a barra de título só tem as ferramentas. -->
        <ui:TitleBar Grid.Row="0"
                     ShowMaximize="False"
                     ShowMinimize="False">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- Uso doméstico: entra sem domínio e só permite este computador como destino. -->
                    <ui:Button Style="{StaticResource TitleBarToolButtonStyle}"
                               ToolTip="{DynamicResource Login_UseLocallyToolTip}"
                               IsEnabled="{Binding IsAuthenticating, Converter={StaticResource InverseBoolConverter}}"
                               Click="UseLocally_OnClick">
                        <ui:SymbolIcon Symbol="Desktop24" FontSize="16" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </ui:Button>
                    <ui:Button Style="{StaticResource TitleBarToolButtonStyle}"
                               Command="{Binding ToggleThemeCommand}">
                        <ui:Button.ToolTip>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource Login_ThemeToggle_DarkToolTip}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource Login_ThemeToggle_LightToolTip}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ui:Button.ToolTip>
                        <appControls:ThemeToggleIcon Style="{StaticResource ThemeToggleIconStyle}"/>
                    </ui:Button>
                    <ui:Button Style="{StaticResource TitleBarToolButtonStyle}"
                               ToolTip="{DynamicResource Login_SettingsToolTip}"
                               Click="Settings_OnClick">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="16" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalContentAlignment="Center">
        <StackPanel
                    VerticalAlignment="Center"
                    Margin="36,8,36,32">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                <Image Source="{StaticResource HermesEmblemImage}" Width="56" Height="56"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <appControls:LetterSpacedText Text="HERMES"
                                                  FontFamily="{StaticResource AppDisplayFontFamily}"
                                                  FontSize="32"
                                                  FontWeight="SemiBold"
                                                  Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <appControls:LetterSpacedText Text="{DynamicResource Login_Tagline}"
                                                  Margin="0,6,0,0"
                                                  Spacing="0.3"
                                                  FontFamily="{StaticResource AppMonoFontFamily}"
                                                  FontSize="10"
                                                  Foreground="{DynamicResource AppBrandSubtitleBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Usuário -->
            <TextBlock Text="{DynamicResource Login_UserLabel}" Style="{StaticResource LoginFieldLabelStyle}"/>
            <Border Style="{StaticResource LoginFieldContainerStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="Person24"
                                   FontSize="16"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource Login_UserPlaceholder}"
                                   Foreground="{DynamicResource AppTextMutedBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding UserName, Converter={StaticResource StringNullOrEmptyToVis}}"/>
                        <TextBox x:Name="UserNameTextBox"
                                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LoginInnerTextBoxStyle}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Senha -->
            <TextBlock Text="{DynamicResource Login_PasswordLabel}" Style="{StaticResource LoginFieldLabelStyle}" Margin="0,18,0,8"/>
            <Border Style="{StaticResource LoginFieldContainerStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="LockClosed24"
                                   FontSize="16"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock Text="{DynamicResource Login_PasswordPlaceholder}"
                                   Foreground="{DynamicResource AppTextMutedBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Password, Converter={StaticResource StringNullOrEmptyToVis}}"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource LoginInnerPasswordBoxStyle}"
                                     PasswordChanged="PasswordBox_OnPasswordChanged"
                                     Visibility="{Binding IsPasswordRevealed, Converter={StaticResource InverseBoolToVis}}"/>
                        <TextBox x:Name="RevealedPasswordTextBox"
                                 Style="{StaticResource LoginInnerTextBoxStyle}"
                                 TextChanged="RevealedPasswordTextBox_OnTextChanged"
                                 Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <ui:Button Grid.Column="2"
                               Style="{StaticResource ToolButtonStyle}"
                               Padding="8,6"
                               Margin="0,0,4,0"
                               Focusable="False"
                               Command="{Binding TogglePasswordVisibilityCommand}">
                        <ui:Button.ToolTip>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource Login_ShowPasswordToolTip}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPasswordRevealed}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource Login_HidePasswordToolTip}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ui:Button.ToolTip>
                        <ui:SymbolIcon FontSize="16" Foreground="{DynamicResource AppTextPrimaryBrush}">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="Eye24"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPasswordRevealed}" Value="True">
                                            <Setter Property="Symbol" Value="EyeOff24"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </ui:Button>
                </Grid>
            </Border>

            <CheckBox Content="{DynamicResource Login_RememberMeLabel}"
                      IsChecked="{Binding RememberMe}"
                      Margin="0,16,0,0"/>

            <Border Background="{DynamicResource AppBadgeDangerBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBadgeDangerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,12,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVis}, ConverterParameter=Invert}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="ErrorCircle24"
                                   FontSize="16"
                                   Foreground="{DynamicResource AppBadgeDangerForegroundBrush}"
                                   Margin="0,1,8,0"
                                   VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource AppBadgeDangerForegroundBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ErrorGuidance}"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding ErrorGuidance, Converter={StaticResource StringNullOrEmptyToVis}, ConverterParameter=Invert}"/>
                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding ErrorDetails, Converter={StaticResource StringNullOrEmptyToVis}, ConverterParameter=Invert}">
                            <ui:Button x:Name="ErrorDetailsToggleButton"
                                       Style="{StaticResource ToolButtonStyle}"
                                       Command="{Binding ToggleErrorDetailsCommand}"
                                       HorizontalAlignment="Left"
                                       MinHeight="24"
                                       Padding="0"
                                       FontSize="12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Foreground="{DynamicResource AppBrandAccentBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{DynamicResource Login_ShowErrorDetails}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsErrorDetailsExpanded}" Value="True">
                                                        <Setter Property="Text" Value="{DynamicResource Login_HideErrorDetails}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ui:SymbolIcon FontSize="12"
                                                   Foreground="{DynamicResource AppBrandAccentBrush}"
                                                   Margin="6,0,0,0">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="ChevronDown24"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsErrorDetailsExpanded}" Value="True">
                                                        <Setter Property="Symbol" Value="ChevronUp24"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </StackPanel>
                            </ui:Button>
                            <TextBox Text="{Binding ErrorDetails, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     MaxHeight="160"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     Background="{DynamicResource AppInputBackgroundBrush}"
                                     Foreground="{DynamicResource AppTextSecondaryBrush}"
                                     BorderBrush="{DynamicResource AppInputBorderBrush}"
                                     FontSize="11"
                                     Padding="8"
                                     Margin="0,6,0,0"
                                     Visibility="{Binding IsErrorDetailsExpanded, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Entrar; enquanto autentica, o mesmo botão (ou Esc) cancela. Enter não cancela. -->
            <ui:Button x:Name="SignInButton"
                       Style="{StaticResource LoginSubmitButtonStyle}"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Center"
                       MinHeight="46"
                       Padding="0,10"
                       Margin="0,20,0,0"
                       IsDefault="{Binding IsAuthenticating, Converter={StaticResource InverseBoolConverter}}"
                       Click="SignIn_OnClick">
                <Grid>
                    <TextBlock Text="{DynamicResource Login_SignInButton}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                               HorizontalAlignment="Center"
                               Visibility="{Binding IsAuthenticating, Converter={StaticResource InverseBoolToVis}}"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsAuthenticating, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing Width="16"
                                         Height="16"
                                         IsIndeterminate="True"
                                         Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Login_CancelSignInButton}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </ui:Button>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</appControls:HermesWindow>
