<appControls:HermesWindow x:Class="PrinterInstall.App.Views.RemovalWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PrinterInstall.App.Converters"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:appControls="clr-namespace:PrinterInstall.App.Controls"
        Title="{DynamicResource Removal_WindowTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{DynamicResource AppCanvasBackgroundBrush}"
        TextElement.Foreground="{DynamicResource AppTextPrimaryBrush}">
    <appControls:HermesWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:StringNullOrWhiteSpaceToVisibilityConverter x:Key="StringEmptyToVisibilityConverter"/>
        <Style TargetType="TabControl">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </appControls:HermesWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"/>
        <appControls:BrandTitle Grid.Row="0"
                                Margin="16,0,0,0"
                                HorizontalAlignment="Left"
                                Subtitle="{DynamicResource Removal_WindowTitle}"
                                IsAnimating="{Binding IsExecuting}"/>

        <Grid Grid.Row="1" Margin="16,8,16,16">
            <TabControl SelectedIndex="{Binding CurrentStepIndex}"
                        BorderThickness="0"
                        Background="Transparent"
                        Padding="0">
                <TabItem>
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Removal_Step0Intro}"
                                           FontSize="14"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           LineHeight="20"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource Removal_Step0KeyboardHint}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                       Content="{DynamicResource Removal_AddThisComputer}"
                                       Command="{Binding AddThisComputerCommand}"
                                       Style="{StaticResource OutlineButtonStyle}"
                                       VerticalAlignment="Top"
                                       Padding="8,4"/>
                        </Grid>
                        <ui:Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Padding="16,6"
                                Content="{DynamicResource Removal_Next}" Command="{Binding StartCommand}" Margin="0,8,0,0" Style="{StaticResource PrimaryActionButtonStyle}" IsDefault="True"/>
                        <TextBox Text="{Binding ComputersText, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsLocalOnly}"
                                 AcceptsReturn="True"
                                 FontFamily="{StaticResource AppMonoFontFamily}"
                                 FontSize="13"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </TabItem>

                <TabItem>
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentStepLabel}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <!-- Conectividade como na tabela de status: ponto colorido e texto, sem etiqueta. -->
                                <StackPanel Margin="14,0,0,0" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding HasPingBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Ellipse Width="8" Height="8" Margin="0,1,8,0" VerticalAlignment="Center"
                                             Fill="{Binding PingBadgeDot}"/>
                                    <TextBlock Text="{Binding PingStatusBadgeText}"
                                               Foreground="{Binding PingBadgeForeground}"
                                               FontWeight="Medium"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <ui:Button Grid.Row="0" Grid.Column="1"
                                       Content="{DynamicResource Removal_ResetSpoolerButton}"
                                       Command="{Binding ResetCurrentMachineSpoolerCommand}"
                                       ToolTip="{DynamicResource Removal_ResetSpoolerHint}"
                                       ToolTipService.ShowOnDisabled="True"
                                       AutomationProperties.HelpText="{DynamicResource Removal_ResetSpoolerHint}"
                                       Style="{StaticResource OutlineButtonStyle}"
                                       VerticalAlignment="Center"
                                       Padding="10,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding QueuesLoadError}" Foreground="{DynamicResource AppBadgeDangerForegroundBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding QueuesLoadError, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                        </Grid>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <ui:Button Content="{DynamicResource Removal_Next}" Command="{Binding NextQueueStepCommand}" Padding="16,6" Style="{StaticResource PrimaryActionButtonStyle}"/>
                        </StackPanel>
                        <Border Background="{DynamicResource AppSurfaceCardBrush}"
                                BorderBrush="{DynamicResource AppSurfaceCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="4">
                            <Grid>
                                <DataGrid ItemsSource="{Binding QueuesForCurrentComputer}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                          SelectionMode="Single"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{DynamicResource AppTableDividerBrush}"
                                          VerticalGridLinesBrush="{x:Null}"
                                          RowBackground="Transparent"
                                          AlternatingRowBackground="Transparent"
                                          Background="Transparent"
                                          BorderThickness="0">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsComputerOffline}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                    <!-- WPF has no SelectionMode.None; "None" crashes at load. Hide row/cell selection visuals. -->
                                    <DataGrid.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                                    </DataGrid.Resources>
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AppTableDividerBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
                                            <Setter Property="Padding" Value="10,8,10,8"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="MinHeight" Value="40"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AppTableDividerBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AppTableHoverBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="10,8,10,8"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{DynamicResource Removal_ColumnRemove}" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{DynamicResource Removal_ColumnPrinter}" Binding="{Binding Name}" Width="*" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{DynamicResource Removal_ColumnPort}" Binding="{Binding PortName}" Width="200" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <!-- Porta é dado (IP_<endereço>): Consolas, como a coluna Computador da janela principal. -->
                                                <Setter Property="FontFamily" Value="{StaticResource AppMonoFontFamily}"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="{DynamicResource Removal_ColumnNewName}" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource AppInputBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Background="{DynamicResource AppInputBackgroundBrush}"
                                                        Padding="4,2"
                                                        VerticalAlignment="Center">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="&#xE70F;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center"/>
                                                        <Grid Grid.Column="1">
                                                            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                                                     IsEnabled="{Binding IsRenameEditable}"
                                                                     VerticalAlignment="Center"
                                                                     BorderThickness="0"
                                                                     Background="Transparent"
                                                                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                                     CaretBrush="{DynamicResource AppTextPrimaryBrush}"
                                                                     Padding="2,0"/>
                                                            <TextBlock Text="{DynamicResource Removal_RenamePlaceholder}"
                                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                       Margin="4,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       IsHitTestVisible="False"
                                                                       Visibility="{Binding NewName, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{DynamicResource Removal_NoPrintersFound}" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding ShowQueuesEmptyHint, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <!-- Mensagem informativa quando o computador estiver offline -->
                            <Border Background="Transparent"
                                    Padding="24" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"
                                    Visibility="{Binding ShowComputerOfflineHint, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{DynamicResource AppBadgeDangerForegroundBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <TextBlock Text="{DynamicResource Removal_Queues_OfflineTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource Removal_Queues_OfflineHint}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,16"/>
                                    <ui:Button Content="{DynamicResource Removal_Ping_RetryButton}" Command="{Binding RetryCurrentMachineCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Center" Padding="14,6"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource AppSurfaceCardBrush}" Opacity="0.9"
                                    Visibility="{Binding IsLoadingQueues, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                                    <ui:ProgressRing IsIndeterminate="True" Width="44" Height="44"/>
                                    <TextBlock Text="{Binding LoadingStatusMessage}" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,12,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- Etapa 2: Revisão do Plano -->
            <TabItem>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Removal_ReviewHeader}"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Margin="0,0,0,8"/>

                        <!-- Barra de métricas rápidas -->
                        <Border Background="{DynamicResource AppSurfaceCardBrush}"
                                BorderBrush="{DynamicResource AppSurfaceCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Totais do plano: ponto colorido, rótulo e número, como o resumo do Status. -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <Ellipse Width="8" Height="8" Margin="0,1,8,0" VerticalAlignment="Center" Fill="{DynamicResource AppBadgeDangerForegroundBrush}"/>
                                    <TextBlock Text="{DynamicResource Removal_ReviewRemovals}" Margin="0,0,5,0" FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ReviewTotalRemovals}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <Ellipse Width="8" Height="8" Margin="0,1,8,0" VerticalAlignment="Center" Fill="{DynamicResource AppBrandAccentBrush}"/>
                                    <TextBlock Text="{DynamicResource Removal_ReviewRenames}" Margin="0,0,5,0" FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ReviewTotalRenames}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,1,8,0" VerticalAlignment="Center" Fill="{DynamicResource AppTextMutedBrush}"/>
                                    <TextBlock Text="{DynamicResource Removal_ReviewComputers}" Margin="0,0,5,0" FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ReviewTotalComputers}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" Margin="0,10,0,0">
                        <ui:Button Content="{DynamicResource Removal_ExecuteButton}" Command="{Binding ExecuteCommand}"
                                   IsEnabled="{Binding CanExecute}" HorizontalAlignment="Right" Padding="18,7" Style="{StaticResource PrimaryActionButtonStyle}"/>
                    </StackPanel>

                    <!-- Console moderno para detalhamento do plano -->
                    <Border Background="{DynamicResource AppConsoleBackgroundBrush}"
                            BorderBrush="{DynamicResource AppConsoleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <TextBox Text="{Binding ReviewSummary, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 FontFamily="{StaticResource AppMonoFontFamily}"
                                 FontSize="12"
                                 Foreground="{DynamicResource AppConsoleForegroundBrush}"
                                 CaretBrush="{DynamicResource AppConsoleForegroundBrush}"/>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- Etapa 3: Log de Execução -->
            <TabItem>
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="{DynamicResource Removal_LogHeader}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Margin="0,0,0,10"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <ui:Button Content="{DynamicResource Removal_OpenLogFolderButton}" Command="{Binding OpenLogFolderCommand}" Icon="{ui:SymbolIcon FolderOpen24}" Style="{StaticResource ToolButtonStyle}" Padding="12,6" Margin="0,0,8,0"/>
                        <ui:Button Content="{DynamicResource Removal_ExportLogButton}"
                                   Command="{Binding ExportLogCommand}"
                                   Padding="16,6" Margin="0,0,8,0" Style="{StaticResource OutlineButtonStyle}"/>
                        <ui:Button Content="{DynamicResource Removal_CloseButton}"
                                   Command="{Binding CloseCommand}" IsEnabled="{Binding CanClose}"
                                   Padding="16,6" Style="{StaticResource PrimaryActionButtonStyle}"/>
                    </StackPanel>

                    <!-- Console moderno para saída de log -->
                    <Border Background="{DynamicResource AppConsoleBackgroundBrush}"
                            BorderBrush="{DynamicResource AppConsoleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <TextBox Text="{Binding LogText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 FontFamily="{StaticResource AppMonoFontFamily}"
                                 FontSize="12"
                                 Foreground="{DynamicResource AppConsoleForegroundBrush}"
                                 CaretBrush="{DynamicResource AppConsoleForegroundBrush}"/>
                    </Border>
                </DockPanel>
            </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</appControls:HermesWindow>
