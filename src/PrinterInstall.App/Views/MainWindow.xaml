<appControls:HermesWindow x:Class="PrinterInstall.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:PrinterInstall.App.Converters"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        xmlns:appControls="clr-namespace:PrinterInstall.App.Controls"
        xmlns:vm="clr-namespace:PrinterInstall.App.ViewModels;assembly=PrinterInstall.App"
        mc:Ignorable="d"
        Title="{DynamicResource Main_WindowTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="700" Width="1000"
        MinHeight="540" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{DynamicResource AppCanvasBackgroundBrush}"
        TextElement.Foreground="{DynamicResource AppTextPrimaryBrush}">
    <appControls:HermesWindow.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:TargetMachineStateToBrushConverter x:Key="StateBrushConverter"/>
        <conv:StringNullOrWhiteSpaceToVisibilityConverter x:Key="EmptyToVis"/>

        <!-- Pincéis para neutralizar seleção azul padrão do WPF -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource AppTextPrimaryColor}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource AppTextPrimaryColor}"/>

        <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource PanelStyle}"/>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>

        <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Contadores em destaque: mesma fonte da interface, só mais pesada. -->
        <Style x:Key="FigureTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>

        <!-- Plural simples do contador de computadores -->
        <Style x:Key="ComputerCountUnitStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Text" Value="{DynamicResource Main_ComputersCountMany}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ComputerCount}" Value="1">
                    <Setter Property="Text" Value="{DynamicResource Main_ComputersCountOne}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InvalidCountUnitStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AppBadgeDangerForegroundBrush}"/>
            <Setter Property="Text" Value="{DynamicResource Main_ComputersInvalidMany}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding InvalidComputerCount}" Value="1">
                    <Setter Property="Text" Value="{DynamicResource Main_ComputersInvalidOne}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Estilos para a tabela moderna de status -->
        <Style x:Key="StatusColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0,1,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableDividerBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableDividerBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppTableHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppTableRowSelectedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusTextElementStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Message}"/>
        </Style>

        <Style x:Key="StatusMonoTextElementStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusTextElementStyle}">
            <Setter Property="FontFamily" Value="{StaticResource AppMonoFontFamily}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style x:Key="StatusSecondaryTextElementStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusTextElementStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        </Style>

        <Style x:Key="ModernStatusDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppTableDividerBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{x:Null}"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource StatusColumnHeaderStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource StatusCellStyle}"/>
            <Setter Property="RowStyle" Value="{StaticResource StatusRowStyle}"/>
        </Style>
    </appControls:HermesWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0">
            <ui:TitleBar.TrailingContent>
                <ui:Button Style="{StaticResource TitleBarToolButtonStyle}"
                           Command="{Binding ToggleThemeCommand}">
                    <ui:Button.ToolTip>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{DynamicResource Main_ThemeToggle_DarkToolTip}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                            <Setter Property="Text" Value="{DynamicResource Main_ThemeToggle_LightToolTip}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ui:Button.ToolTip>
                    <appControls:ThemeToggleIcon Style="{StaticResource ThemeToggleIconStyle}"/>
                </ui:Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>
        <!-- O emblema voa enquanto a implantação roda. -->
        <appControls:BrandTitle Grid.Row="0"
                                Margin="16,0,0,0"
                                HorizontalAlignment="Left"
                                IsAnimating="{Binding IsDeployRunning}"/>
        <Border Grid.Row="0" VerticalAlignment="Bottom" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource AppSurfaceCardBorderBrush}" IsHitTestVisible="False"/>

        <!-- Barra de comandos: fluxo de implantação à esquerda, ferramentas separadas à direita -->
        <Grid Grid.Row="1" Margin="20,14,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:Button Content="{DynamicResource Main_DeployButton}"
                           Icon="{ui:SymbolIcon Play24, Filled=True}"
                           Command="{Binding DeployCommand}"
                           Style="{StaticResource PrimaryActionButtonStyle}"
                           MinWidth="120"/>
                <ui:Button Content="{Binding CancelDeployButtonText}"
                           Icon="{ui:SymbolIcon Dismiss24}"
                           Command="{Binding CancelDeployCommand}"
                           Visibility="{Binding IsDeployRunning, Converter={StaticResource BoolToVis}}"
                           Style="{StaticResource OutlineButtonStyle}"
                           MinHeight="38"
                           Margin="8,0,0,0"
                           Padding="16,8"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button Content="{DynamicResource Main_RemovePrintersButton}"
                           Command="{Binding OpenRemovalWizardCommand}"
                           Style="{StaticResource ToolButtonStyle}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Print24" Foreground="{DynamicResource AppBrandAccentBrush}"/>
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="{DynamicResource Main_TestPrinterButton}"
                           Command="{Binding OpenPrinterNetworkTestCommand}"
                           Style="{StaticResource ToolButtonStyle}"
                           Margin="4,0,0,0">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="PlugConnected24" Foreground="{DynamicResource AppBrandAccentBrush}"/>
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="20,0,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="260"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="130"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="3*" MinHeight="140"/>
                    </Grid.RowDefinitions>

                    <!-- Computadores alvo -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Main_ComputersLabel}" Style="{StaticResource SectionHeaderStyle}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource FigureTextStyle}" Text="{Binding ComputerCount}"/>
                                    <TextBlock Style="{StaticResource ComputerCountUnitStyle}" Margin="6,1,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                                Visibility="{Binding HasInvalidComputers, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="·" Margin="0,0,8,0"/>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding InvalidComputerCount}"
                                                   Foreground="{DynamicResource AppBadgeDangerForegroundBrush}"/>
                                        <TextBlock Style="{StaticResource InvalidCountUnitStyle}" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <ui:Button Grid.Column="2"
                                           Content="{DynamicResource Main_AddThisComputer}"
                                           Icon="{ui:SymbolIcon Desktop24}"
                                           Command="{Binding AddThisComputerCommand}"
                                           Style="{StaticResource OutlineButtonStyle}"
                                           Padding="10,5"/>
                            </Grid>
                            <!-- Nomes digitados em Consolas; a instrução, na fonte da interface (o placeholder do WPF UI herdaria a Consolas). -->
                            <Grid>
                                <ui:TextBox Text="{Binding ComputersText, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="{Binding IsLocalOnly}"
                                            AcceptsReturn="True"
                                            FontFamily="{StaticResource AppMonoFontFamily}"
                                            FontSize="13"
                                            Padding="12,10"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto"
                                            VerticalContentAlignment="Top"/>
                                <TextBlock Text="{DynamicResource Main_ComputersPlaceholder}"
                                           Margin="15,11,12,0"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextControlPlaceholderForeground}"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding ComputersText, Converter={StaticResource EmptyToVis}}"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Status -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0,14,0,0">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" Margin="16,0,16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Main_StatusGroupHeader}"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <!-- Resumo: concluídos sobre o total e barra dividida por resultado. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0"
                                            Visibility="{Binding ShowStatusEmptyHint, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Style="{StaticResource FigureTextStyle}" Text="{Binding StatusSucceededCount}"/>
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{DynamicResource Main_StatusSummaryOf}" Margin="5,1,5,0"/>
                                    <TextBlock Style="{StaticResource FigureTextStyle}" Text="{Binding StatusTargetCount}"/>
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{DynamicResource Main_StatusSummarySucceeded}" Margin="5,1,0,0"/>
                                </StackPanel>
                                <appControls:StatusProgressBar Grid.Column="2" Height="6" VerticalAlignment="Center"
                                                               SucceededCount="{Binding StatusSucceededCount}"
                                                               FailedCount="{Binding StatusFailedCount}"
                                                               TotalCount="{Binding StatusTargetCount}"
                                                               IsRunning="{Binding IsDeployRunning}"
                                                               Visibility="{Binding ShowStatusEmptyHint, Converter={StaticResource InverseBoolToVis}}"/>
                            </Grid>
                            <Grid>
                                <DataGrid Style="{StaticResource ModernStatusDataGridStyle}"
                                          ItemsSource="{Binding Targets}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False"
                                          Visibility="{Binding ShowStatusEmptyHint, Converter={StaticResource InverseBoolToVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{DynamicResource Main_ColumnComputer}" Binding="{Binding ComputerNameDisplay}" Width="*" MinWidth="130" ElementStyle="{StaticResource StatusMonoTextElementStyle}"/>
                                        <DataGridTextColumn Header="{DynamicResource Main_ColumnQueue}" Binding="{Binding PrinterQueueName}" Width="140" ElementStyle="{StaticResource StatusSecondaryTextElementStyle}"/>
                                        <!-- Largura do estado mais longo ("Identificação inconclusiva") com o ponto e o espaçamento da célula. -->
                                        <DataGridTemplateColumn Header="{DynamicResource Main_ColumnState}" Width="220" MinWidth="220">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <!-- Ponto colorido e texto, sem etiqueta: cor só para o estado, como no Talos. -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8"
                                                                 Margin="0,1,8,0"
                                                                 VerticalAlignment="Center"
                                                                 Fill="{Binding State, Converter={StaticResource StateBrushConverter}, ConverterParameter=Dot}"/>
                                                        <TextBlock Text="{Binding StateDisplay}"
                                                                   ToolTip="{Binding StateDisplay}"
                                                                   FontSize="13"
                                                                   FontWeight="Medium"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{Binding State, Converter={StaticResource StateBrushConverter}, ConverterParameter=Foreground}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{DynamicResource Main_ColumnMessage}" Binding="{Binding Message}" Width="*" ElementStyle="{StaticResource StatusSecondaryTextElementStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{DynamicResource Main_StatusEmptyHint}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="16"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           Visibility="{Binding ShowStatusEmptyHint, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Configuração de impressora -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Main_PrintersGroupHeader}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   TextWrapping="Wrap"
                                   Margin="2,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding PrinterRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,8">
                                                <TextBlock Text="{DynamicResource Main_BrandLabel}" Style="{StaticResource FieldLabelStyle}"/>
                                                <ComboBox ItemsSource="{Binding Source={x:Static vm:PrinterFormRowViewModel.BrandChoices}}" SelectedItem="{Binding Brand}" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,8">
                                                <TextBlock Text="{DynamicResource Main_PrinterHostLabel}" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox Text="{Binding PrinterHostAddress, UpdateSourceTrigger=PropertyChanged}"
                                                         FontFamily="{StaticResource AppMonoFontFamily}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                                <TextBlock Text="{DynamicResource Main_DisplayNameLabel}" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                        Visibility="{Binding IsGainschaBrand, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{DynamicResource Main_GainschaLabelPresetLabel}" Style="{StaticResource FieldLabelStyle}"/>
                                                <ComboBox ItemsSource="{Binding Source={x:Static vm:PrinterFormRowViewModel.GainschaLabelPresetChoices}}"
                                                          SelectedItem="{Binding GainschaLabelPreset}"
                                                          HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:Button Content="{DynamicResource Main_AddPrinterRow}"
                                       Icon="{ui:SymbolIcon Add24}"
                                       Command="{Binding AddPrinterRowCommand}"
                                       Style="{StaticResource OutlineButtonStyle}"
                                       Margin="0,0,8,0"/>
                            <ui:Button Content="{DynamicResource Main_RemovePrinterRow}"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       Command="{Binding RemovePrinterRowCommand}" CommandParameter="{x:Null}"
                                       Visibility="{Binding CanRemovePrinterRow, Converter={StaticResource BoolToVis}}"
                                       Style="{StaticResource ToolButtonStyle}"
                                       Padding="12,6"/>
                        </StackPanel>
                        <CheckBox Content="{DynamicResource Main_PrintTestPageLabel}" IsChecked="{Binding PrintTestPage}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Log recolhível: prévia da última linha quando fechado -->
            <Expander Grid.Row="1"
                      x:Name="LogExpander"
                      Margin="0,12,0,0"
                      IsExpanded="False"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Background="{DynamicResource AppSurfaceCardBrush}"
                      BorderBrush="{DynamicResource AppSurfaceCardBorderBrush}">
                <Expander.Header>
                    <Grid Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Main_LogGroupHeader}" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Grid.Column="1"
                                   Margin="12,0"
                                   FontFamily="{StaticResource AppMonoFontFamily}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Log.LastLine}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded, ElementName=LogExpander}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <ui:Button Content="{DynamicResource Main_OpenLogFolderButton}"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       Command="{Binding OpenLogFolderCommand}"
                                       Style="{StaticResource ToolButtonStyle}"
                                       Padding="10,4"
                                       Margin="0,0,4,0"/>
                            <ui:Button Content="{DynamicResource Main_ExportLogButton}"
                                       Icon="{ui:SymbolIcon DocumentArrowRight24}"
                                       Command="{Binding ExportLogCommand}"
                                       IsEnabled="{Binding CanExportLog}"
                                       Style="{StaticResource OutlineButtonStyle}"
                                       Padding="10,4"/>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <TextBox Text="{Binding LogText, Mode=OneWay}"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         Height="150"
                         FontFamily="{StaticResource AppMonoFontFamily}"
                         FontSize="12"
                         Background="{DynamicResource AppConsoleBackgroundBrush}"
                         BorderBrush="{DynamicResource AppConsoleBorderBrush}"
                         Foreground="{DynamicResource AppConsoleForegroundBrush}"
                         Padding="8"/>
            </Expander>
        </Grid>
    </Grid>
</appControls:HermesWindow>
