<appControls:HermesWindow x:Class="PrinterInstall.App.Views.PrinterNetworkTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:appControls="clr-namespace:PrinterInstall.App.Controls"
        xmlns:conv="clr-namespace:PrinterInstall.App.Converters"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        Title="{DynamicResource NetworkTest_WindowTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{DynamicResource AppCanvasBackgroundBrush}"
        TextElement.Foreground="{DynamicResource AppTextPrimaryBrush}"
        UseLayoutRounding="True">
    <appControls:HermesWindow.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StringNullOrWhiteSpaceToVisibilityConverter x:Key="StringToVis"/>
    </appControls:HermesWindow.Resources>
    <StackPanel>
    <Grid>
        <ui:TitleBar ShowMaximize="False"
                     ShowMinimize="False"/>
        <appControls:BrandTitle Margin="16,0,0,0"
                                HorizontalAlignment="Left"
                                Subtitle="{DynamicResource NetworkTest_WindowTitle}"
                                IsAnimating="{Binding IsRunning}"/>
    </Grid>
    <Grid Margin="20,8,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource NetworkTest_Hint}"
                       FontSize="14"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource NetworkTest_BrandLabel}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding BrandChoices}" SelectedItem="{Binding SelectedBrand}"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,12"
                        Visibility="{Binding IsGainschaBrand, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{DynamicResource Main_GainschaLabelPresetLabel}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding GainschaLabelPresetChoices}"
                          SelectedItem="{Binding SelectedGainschaLabelPreset}"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="{DynamicResource NetworkTest_HostLabel}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           Margin="0,0,0,6"/>
                <TextBox Text="{Binding HostAddress, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{StaticResource AppMonoFontFamily}"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          MaxHeight="72"
                          Margin="0,0,0,8"
                          Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}, ConverterParameter=Invert}">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,6,0,0">
            <ui:Button Content="{DynamicResource NetworkTest_RunButton}"
                       Command="{Binding RunTestCommand}"
                       Style="{StaticResource PrimaryActionButtonStyle}"
                       Padding="16,6"
                       Margin="0,0,8,0"/>
            <ui:Button Content="{DynamicResource NetworkTest_CloseButton}"
                       IsCancel="True"
                       Padding="16,6"
                       Style="{StaticResource OutlineButtonStyle}"/>
        </StackPanel>
    </Grid>
    </StackPanel>
</appControls:HermesWindow>
