<Application x:Class="PrinterInstall.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:appControls="clr-namespace:PrinterInstall.App.Controls"
             Startup="App_OnStartup"
             Exit="App_OnExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/Brand.xaml"/>
                <ResourceDictionary Source="Themes/ThemeTokens.Light.xaml"/>
                <ResourceDictionary Source="Strings/Main.pt-BR.xaml"/>
                <ResourceDictionary Source="Strings/Login.pt-BR.xaml"/>
                <ResourceDictionary Source="Strings/RemovalWizard.pt-BR.xaml"/>
                <ResourceDictionary Source="Strings/PrinterNetworkTest.pt-BR.xaml"/>
                <ResourceDictionary Source="Strings/Settings.pt-BR.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
              Três papéis de fonte: Segoe UI (padrão do WPF UI) em toda a interface; Bahnschrift só no
              nome HERMES; Consolas nos dados que se digitam ou leem como valor (nome de computador, IP,
              log) e no slogan da marca. Consolas vem em todo Windows, ao contrário da Cascadia Mono.
            -->
            <FontFamily x:Key="AppDisplayFontFamily">Bahnschrift</FontFamily>
            <FontFamily x:Key="AppMonoFontFamily">Consolas, Courier New</FontFamily>

            <Style TargetType="DataGrid">
                <Setter Property="CanUserReorderColumns" Value="False"/>
            </Style>

            <!-- Botões de ferramenta: sem moldura, como na barra de comandos do Windows 11 -->
            <Style x:Key="ToolButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                <Setter Property="MouseOverBackground" Value="{DynamicResource AppSurfaceHoverBrush}"/>
                <Setter Property="Padding" Value="12,8"/>
            </Style>

            <!-- Ferramenta da barra de título (tema, configurações): mesma caixa dos botões da janela (ver HermesWindow). -->
            <Style x:Key="TitleBarToolButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource ToolButtonStyle}">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="48"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <!--
              Ação principal da tela: acento cheio, texto escuro no tema escuro como no Talos.
              As cores ficam em gatilhos porque os gatilhos de Appearance do estilo base do WPF UI
              venceriam setters comuns; gatilhos do estilo derivado são avaliados depois.
            -->
            <Style x:Key="PrimaryActionButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Primary"/>
                <Setter Property="MouseOverBackground" Value="{DynamicResource AppAccentHoverBrush}"/>
                <Setter Property="MouseOverBorderBrush" Value="{DynamicResource AppAccentHoverBrush}"/>
                <Setter Property="PressedBackground" Value="{DynamicResource AppAccentPressedBrush}"/>
                <Setter Property="PressedBorderBrush" Value="{DynamicResource AppAccentPressedBrush}"/>
                <Setter Property="PressedForeground" Value="{DynamicResource AppAccentForegroundBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="20,8"/>
                <Setter Property="MinHeight" Value="38"/>
                <Style.Triggers>
                    <Trigger Property="Appearance" Value="Primary">
                        <Setter Property="Background" Value="{DynamicResource AppBrandAccentBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AppBrandAccentBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource AppSurfaceCardBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AppSurfaceCardBorderBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Ação secundária: só contorno, como o .btn do Talos. -->
            <Style x:Key="OutlineButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Secondary"/>
                <Setter Property="MouseOverBackground" Value="{DynamicResource AppSurfaceHoverBrush}"/>
                <Setter Property="MouseOverBorderBrush" Value="{DynamicResource AppBrandAccentBrush}"/>
                <Setter Property="PressedBackground" Value="{DynamicResource AppSurfaceHoverBrush}"/>
                <Setter Property="PressedBorderBrush" Value="{DynamicResource AppBrandAccentBrush}"/>
                <Setter Property="PressedForeground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                <Setter Property="Padding" Value="12,6"/>
                <Style.Triggers>
                    <Trigger Property="Appearance" Value="Secondary">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AppLineStrongBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="BorderBrush" Value="{DynamicResource AppSurfaceCardBorderBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Painel: superfície plana com borda de 1 px e cantos de 6 px, como o .panel do Talos. -->
            <Style x:Key="PanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AppSurfaceCardBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppSurfaceCardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="16"/>
            </Style>

            <!-- Símbolo e contraste seguem o tema salvo desde a abertura da janela. -->
            <Style x:Key="ThemeToggleIconStyle" TargetType="appControls:ThemeToggleIcon">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
                <Setter Property="Symbol" Value="WeatherMoon24"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                        <Setter Property="Symbol" Value="WeatherSunny24"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
