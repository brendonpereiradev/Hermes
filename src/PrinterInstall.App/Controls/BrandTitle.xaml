<UserControl x:Class="PrinterInstall.App.Controls.BrandTitle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:appControls="clr-namespace:PrinterInstall.App.Controls"
             xmlns:conv="clr-namespace:PrinterInstall.App.Converters"
             x:Name="Root"
             IsHitTestVisible="False"
             Focusable="False"
             IsTabStop="False">
    <UserControl.Resources>
        <conv:StringNullOrWhiteSpaceToVisibilityConverter x:Key="StringToVis"/>
    </UserControl.Resources>
    <!-- Fica sobre a barra de título sem receber cliques, para a janela continuar arrastável. -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <appControls:HermesEmblem Width="22" Height="22"
                                  IsAnimating="{Binding IsAnimating, ElementName=Root}"/>
        <appControls:LetterSpacedText Text="HERMES"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      FontFamily="{StaticResource AppDisplayFontFamily}"
                                      FontSize="16"
                                      FontWeight="SemiBold"
                                      Foreground="{DynamicResource AppTextPrimaryBrush}"/>
        <!-- Sem subtítulo (janela principal), a marca fica só com o nome. -->
        <TextBlock Text="{Binding Subtitle, ElementName=Root}"
                   Visibility="{Binding Subtitle, ElementName=Root, Converter={StaticResource StringToVis}, ConverterParameter=Invert}"
                   Margin="8,1,0,0"
                   VerticalAlignment="Center"
                   FontSize="13"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
    </StackPanel>
</UserControl>
